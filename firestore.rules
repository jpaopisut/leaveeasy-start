rules_version = '2';

// กฎขั้นต่ำของสัปดาห์ที่ 7 — กฎข้อเดียว: "ต้องล็อกอินก่อน ถึงจะอ่าน/เขียนอะไรก็ได้"
// ครอบทุก collection ในฐานข้อมูล (leaveRequests, approvals, leaveTypes, users, และ
// collection ใหม่ที่อาจเพิ่มทีหลัง) ด้วย match แบบ wildcard เดียว ไม่ต้องแยกเขียนทีละ collection
//
// ยังไม่มีการเช็ครายบุคคล/รายบทบาท (เช่น employee เห็นแค่ใบของตัวเอง, ลบได้เฉพาะเจ้าของ)
// นั่นคือกฎรายห้องของสัปดาห์ที่ 8 — ตอนนี้ใครก็ตามที่ล็อกอินแล้ว อ่าน/เขียนได้ทุกเอกสาร
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
